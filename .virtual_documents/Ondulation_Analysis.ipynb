        y_pos = bar.get_height() + 0.02
    else:
        val_dir = 'bottom'
        y_pos = bar.get_height() - 0.1
    if (val < 0) & (val > -0.2):
        y_pos = 0.1
    
    ax.text(x_pos, y_pos, f"{val:.2f}%", ha='center', va=val_dir, fontsize=8)
